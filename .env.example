# Workspace MCP: copiar a .env y completar los valores antes de iniciar.

# Secreto de servicio que el cliente MCP debe enviar como Bearer.
# Generar, por ejemplo, con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKSPACE_MCP_TOKEN=replace-with-a-random-secret-of-at-least-24-characters

# Directorio del host que se monta en el contenedor como /workspace.
# Windows: usar barras /, por ejemplo D:/Workspace/projects
WORKSPACE_MCP_WORKSPACE=D:/Workspace/projects
# Puerto local publicado en el host.
WORKSPACE_MCP_PORT=3020

# Opcional: login del propietario (separado del token MCP).
# Si se configura, los tres valores son obligatorios. Password mínimo 12 caracteres.
WORKSPACE_MCP_AUTH_USERNAME=
WORKSPACE_MCP_AUTH_PASSWORD=
WORKSPACE_MCP_AUTH_USER_ID=
WORKSPACE_MCP_AUTH_EMAIL=
WORKSPACE_MCP_AUTH_NAME=

# true = solo lectura (no registra herramientas que modifican archivos ni terminal).
WORKSPACE_MCP_READ_ONLY=false

# true = habilita ejecución de comandos arbitrarios dentro del contenedor.
# Activar solo para un agente de confianza y proteger el token de servicio.
WORKSPACE_MCP_ENABLE_TERMINAL=false

# Opcional: habilita internet_search (la consulta se envía a Brave Search).
WORKSPACE_MCP_BRAVE_API_KEY=

# Para ejecutar fuera de Docker (npm run dev): carpetas permitidas, separadas por ;.
# En Docker, Compose establece WORKSPACE_MCP_ROOTS=/workspace.
# WORKSPACE_MCP_ROOTS=D:/Workspace/projects
# WORKSPACE_MCP_HOST=127.0.0.1
# WORKSPACE_MCP_PORT=3020
