# Copiar a .env (no se commitea). Sirve para los dos modos: Docker (docker compose) y nativo (npm run dev).

# Secreto compartido con agent-runtime. Generar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PC_MCP_TOKEN=replace-me

# Login del propietario del workspace (independiente de PC_MCP_TOKEN).
# Si se configura, los tres valores son obligatorios. Password mínimo 12 caracteres.
# El user ID debe ser estable y único en el huésped: Runtime lo usa para aislar conversaciones.
PC_MCP_AUTH_USERNAME=
PC_MCP_AUTH_PASSWORD=
PC_MCP_AUTH_USER_ID=
# Opcionales, devueltos por GET /auth/me para el Principal del Agent Runtime.
PC_MCP_AUTH_EMAIL=
PC_MCP_AUTH_NAME=

# true = solo leer y buscar (no registra tools que modifican archivos ni terminal).
PC_MCP_READ_ONLY=false

# true = registra run_terminal (ejecuta comandos con los permisos del proceso pc-mcp).
# Es una capacidad potente: habilitala solo si confiás en el agente y protegé PC_MCP_TOKEN.
PC_MCP_ENABLE_TERMINAL=false

# Opcional: habilita la tool internet_search en pc-mcp (Brave Search API).
# La consulta se envía a Brave; la tool no abre las páginas, devuelve resultados y URLs.
PC_MCP_BRAVE_API_KEY=

# ── Docker (docker compose up) ─────────────────────────────────────────────
# Carpeta de tu PC que ve el agente (dentro del contenedor: /workspace).
PC_MCP_WORKSPACE=D:\Workspace\projects

# PostgreSQL compartido por los procesos API y memory-mcp. Cada proceso tiene su pool.
# memory-mcp es dueño de sus tablas public; agent-runtime administra solo el esquema runtime.
# Compose reemplaza el hostname localhost por postgres en ambos contenedores.
DATABASE_URL=postgresql://agent:agent@localhost:5433/memory?schema=public
# Para habilitar config dinámica, generar una clave estable de 32 bytes en hex (openssl rand -hex 32).
# No cambiarla sin migrar/re-encriptar la configuración cifrada.
# RUNTIME_CONFIG_ENCRYPTION_KEY=
# Token Bearer para GET/PUT /admin/runtime-config. Sin token, las rutas devuelven 404.
# RUNTIME_CONFIG_ADMIN_TOKEN=
# Secreto interno compartido por API y Memory MCP; permite a Memory leer solo embeddingConfig.
# Generarlo distinto del token admin (openssl rand -hex 32).
# RUNTIME_CONFIG_INTERNAL_TOKEN=

# agent-runtime. Una línea JSON; ids "proveedor/modelo". providers: openrouter | openai.
AI_CONFIG={"default":"openai/gpt-4.1-mini","providers":{"openai":{"apiKey":"replace-me","models":["gpt-4.1-mini","gpt-4.1"]},"openrouter":{"apiKey":"replace-me","models":["openai/gpt-4.1-mini","anthropic/claude-sonnet-4"]}}}
CHAT_SYSTEM_PROMPT=Hablá en español. Trabajás sobre los archivos de /workspace con las tools pc__*. Leé antes de editar.
CHAT_MAX_TOOL_STEPS=30
CHAT_CONTEXT_TOKENS=100000
# Búsqueda semántica de Memory. La configuración la usa memory-mcp, no agent-runtime.
# Adapter OpenAI-compatible; el modelo debe devolver vectores de 1536 dimensiones.
# Con OpenAI, text-embedding-3-small cumple ese requisito. Al configurarla,
# los documentos pendientes se procesan en background y searchMemory pasa a modo híbrido.
MEMORY_EMBEDDING_CONFIG={"apiKey":"replace-me","baseUrl":"https://api.openai.com/v1","model":"text-embedding-3-small"}

# En Agent Runtime > Admin > Auth, configurar introspección:
# Docker: http://host.docker.internal:3020/auth/me
# (La URL no se configura por variable de entorno; se guarda desde el panel de Runtime.)
CORS_ORIGIN=http://localhost:3010
# Opcionales: versión fija de las imágenes y otro puerto si el 3010 está ocupado.
# AGENT_RUNTIME_VERSION=0.1.0
# AGENT_RUNTIME_PORT=3010
# Solo con docker-compose.local.yml: ruta a tu clon de agent-runtime.
# AGENT_RUNTIME_SRC=../agent-runtime/agent-runtime

# ── Nativo (npm run dev) ──────────────────────────────────────────────────
# Carpetas que el agente puede ver, separadas por ";".
PC_MCP_ROOTS=D:\Workspace\projects
# 127.0.0.1: solo esta máquina (Docker Desktop llega igual por host.docker.internal).
PC_MCP_HOST=127.0.0.1
PC_MCP_PORT=3020
