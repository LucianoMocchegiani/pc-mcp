{
  "name": "pc-mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "MCP que expone carpetas de esta PC (leer, buscar, escribir) a un agente.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.9.8",
    "picomatch": "^4.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/picomatch": "^4.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
